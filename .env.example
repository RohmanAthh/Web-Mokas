# Salin menjadi .env.local lalu isi sesuai kebutuhan.

# Wajib di production: string acak panjang untuk menandatangani cookie login admin
SESSION_SECRET=

# URL publik situs (untuk sitemap, Open Graph, link di notifikasi & pesan WA)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Lokasi file database (default: data/showroom.db)
# DATABASE_PATH=

# ---- Notifikasi lead baru (opsional, boleh lebih dari satu) ----
# Telegram (gratis): buat bot via @BotFather, ambil chat id via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email via SMTP (mis. Gmail App Password, Zoho, Mailtrap)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL_TO=
NOTIFY_EMAIL_FROM=

# WhatsApp via gateway Fonnte (fonnte.com) — nomor tujuan format 628xxx
FONNTE_TOKEN=
NOTIFY_WA_TO=

# Webhook JSON (Zapier, Make, n8n, dsb.)
NOTIFY_WEBHOOK_URL=

# ---- Backup & retensi data ----
# Folder backup (sebaiknya disk lain / folder yang disinkron ke cloud). Default: data/backups
# BACKUP_DIR=
# Jam backup harian (0-23, waktu server). Default 2. Set BACKUP_SCHEDULE=off untuk mematikan.
# BACKUP_HOUR=2
# BACKUP_SCHEDULE=
# Jumlah snapshot database yang disimpan. Default 14
# BACKUP_KEEP=14
# Data pribadi lead dianonimkan setelah N bulan (UU PDP). Default 24
# LEAD_RETENTION_MONTHS=24
